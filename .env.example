# ============================================
# PHARMA MONITOR - CONFIGURACIÓN DE ENTORNO
# ============================================
# Copia este archivo a .env y completa los valores

# --------------------------------------------
# SERVIDOR
# --------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --------------------------------------------
# BASE DE DATOS POSTGRESQL / TIMESCALEDB
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharma_monitor
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_SSL=false

# Para TimescaleDB en la nube (ej. Timescale Cloud, Neon, Supabase):
# DB_HOST=xxx.xxx.xxx.xxx
# DB_SSL=true

# --------------------------------------------
# JWT AUTENTICACIÓN
# --------------------------------------------
JWT_SECRET=tu_clave_secreta_muy_larga_y_segura_aqui_cambiala_en_produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=otra_clave_secreta_para_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------
# EMAIL - OUTLOOK / GMAIL (Nodemailer)
# --------------------------------------------
# OUTLOOK / OFFICE 365
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@siegfried.com
EMAIL_PASS=tu_password_o_app_password
EMAIL_FROM="Pharma Monitor <noreply@siegfried.com>"

# GMAIL (alternativa - descomenta y comenta lo de arriba)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=tu_correo@gmail.com
# EMAIL_PASS=tu_app_password_gmail
# EMAIL_FROM="Pharma Monitor <noreply@tudominio.com>"

# Destinatarios de alertas críticas (separados por coma)
ALERT_EMAILS=gerente@siegfried.com,supervisor@siegfried.com

# --------------------------------------------
# ARDUINO / IOT
# --------------------------------------------
ARDUINO_API_KEY=clave_secreta_para_autenticar_arduinos
ARDUINO_PUSH_INTERVAL_MS=5000

# --------------------------------------------
# UMBRALES GLOBALES (fallback si no hay config por área)
# --------------------------------------------
DEFAULT_TEMP_MIN=18
DEFAULT_TEMP_MAX=32
DEFAULT_HUMEDAD_MAX=65
DEFAULT_PRESION_MIN=10
DEFAULT_PRESION_MAX=15

# --------------------------------------------
# FRONTEND
# --------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000